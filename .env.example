# Personal environment variables.
# Copy this file to .env and configure values as needed.
#
# NEVER commit .env.

# ------------------------------------------------------------
# Git identity
# ------------------------------------------------------------
#
# initializeCommand exports Windows Git user.name/user.email;
# postCreateCommand/postAttachCommand import them in the container.
#
# These variables are provided as an optional fallback for
# environments launched directly with WSLc or environments
# where the host Git configuration is not available.

# GIT_USER_NAME=
# GIT_USER_EMAIL=

# ------------------------------------------------------------
# Authentication / API credentials
# ------------------------------------------------------------

# GITHUB_TOKEN=
# OPENAI_API_KEY=

# ------------------------------------------------------------
# Optional personal tool configuration
# ------------------------------------------------------------

# CODEX_CONFIG=

# Windows host uv executable (literal Windows path; no variable expansion).
# Defaults to %USERPROFILE%\.local\bin\uv.exe; environment overrides .env.
# WINDOWS_UV_PATH=C:\Users\katao\.local\bin\uv.exe
