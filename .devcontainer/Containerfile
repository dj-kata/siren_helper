ARG BASE_IMAGE=localhost/wslc-dev-base:dev
FROM ${BASE_IMAGE}

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libdbus-1-3 \
        libegl1 \
        libgl1 \
        libglib2.0-0 \
        libxkbcommon-x11-0 \
        libxcb-cursor0 \
    && rm -rf /var/lib/apt/lists/*

# Use Emacs shell editing even when EDITOR/VISUAL=vim; load before user fzf bindings.
# System zshrc survives install-dotfiles replacing the user's .zshrc.
RUN printf '%s\n' 'bindkey -e' >> /etc/zsh/zshrc

WORKDIR /workspace/siren_helper
